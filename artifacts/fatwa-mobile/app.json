{
  "expo": {
    "name": "Fatwa App",
    "slug": "fatwa-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "fatwa-mobile",
      "com.fatwa.mobile"
    ],
    "userInterfaceStyle": "light",
    "extra": {
      "privacyPolicyUrl": "https://fatwa-admin.pages.dev/privacy-policy.html"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.fatwa.mobile",
      "versionCode": 2,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-adaptive.png",
        "backgroundColor": "#013A2D"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fatwa-api.ziakhalid236.workers.dev",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fatwa uses your location to show the Qibla direction and prayer times."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6B53",
          "defaultChannel": "adhan-alarms",
          "sounds": [
            "./assets/audio/adhan_drive.mp3",
            "./assets/audio/adhan_notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fatwa App uses your photos and videos when you attach media to a community post."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#013A2D"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
