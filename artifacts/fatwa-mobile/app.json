{
  "expo": {
    "name": "Fatwa Mobile",
    "slug": "fatwa-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fatwa-mobile",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAF8"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.fatwa.mobile",
      "versionCode": 1,
      "supportsTablet": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM", "android.permission.USE_EXACT_ALARM", "android.permission.VIBRATE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#04382D"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fatwa uses your location to show the Qibla direction and prayer times."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6B53",
          "defaultChannel": "adhan-alarms",
          "sounds": ["./assets/audio/adhan_notification.wav"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
